# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Copy to .env.local.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Where the Python Sway API runs (python serve.py).
SWAY_API=http://127.0.0.1:8787

# Sandbox Personal account email (Testing Tools > Sandbox Accounts) that receives payouts for the seeded publishers.
# Keep it here, not in data/publishers.json, which is committed.
SWAY_SANDBOX_PAYOUT_EMAIL=
